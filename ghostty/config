# --- iTerm2-style hotkey window (Ghostty's "Quick Terminal") ---

# Global hotkey to summon/dismiss. `global:` makes it work even when Ghostty
# isn't focused — that's the iTerm2 hotkey-window behavior.
# Default iTerm2 binding is ⌥Space; change to taste (e.g. `global:cmd+grave_accent`).
keybind = global:alt+space=toggle_quick_terminal

# Where the panel slides in from: top | bottom | left | right | center
quick-terminal-position = top

# Size of the panel — pinned in pixels so column/row count stays constant
# across monitors (your built-in is the narrowest at 1512×982 UI points,
# external LG is 2048×2304, portable MB16QHG is 1600×1000).
# Format for position=top is `HEIGHT,WIDTH`. Without the second value Ghostty
# would maximize the secondary axis — that's what caused the width to change
# when you moved between displays.
#
# 640px ≈ 37 rows at JetBrains Mono 13pt (default font). If you see 36 or
# 38 rows after launching, nudge ±15px until it's exactly 37.
quick-terminal-size = 640px,1400px

# Which display to show on: main | mouse | macos-menu-bar
quick-terminal-screen = main

# Slide animation length in seconds. 0 disables.
quick-terminal-animation-duration = 0.2

# Hide automatically when focus leaves it (iTerm2 default behavior).
quick-terminal-autohide = true

# Follow you across macOS Spaces instead of staying pinned: move | remain | move-and-attach
quick-terminal-space-behavior = move


# --- Appearance ---
# Semi-transparent background (matches your iTerm2 Hotkey profile transparency
# of ~0.104). Ghostty's scale is the inverse: 1.0 = opaque, 0.0 = invisible.
background-opacity = 0.9

font-thicken = true
window-colorspace = srgb


# --- Keyboard behavior ---
# Treat the Option key as Alt so `alt+*` keybinds (and Meta-prefixed shell
# shortcuts) fire. Without this, Option+Backspace, Option+arrows, etc. don't
# trigger keybinds — Ghostty passes them through as macOS dead-key sequences.
# Set to `left` if you want Right-Option to keep typing characters like ®, ¨.
macos-option-as-alt = true


# --- Panel splits (ported from iTerm2) ---
# Your iTerm2 bindings (Preferences > Keys):
#   ⌃⇧=  → Split Vertically   (side-by-side)
#   ⌃⇧-  → Split Horizontally (stacked)
keybind = ctrl+shift+==new_split:right
keybind = ctrl+shift+-=new_split:down

# Ghostty's defaults already cover the rest of the split workflow:
#   ⌘W       → close_surface            (close current pane)
#   ⌘] / ⌘[  → goto_split:next/previous
#   ⌘⌥+arrow → goto_split:<direction>
#   ⌘D / ⌘⇧D → also bound to new_split:right / new_split:down (bonus paths)

# iTerm2's ⌘⇧T opens a new tab with the "Hotkey CC Window" profile. Ghostty
# has no profile system, so that distinction is lost — and ⌘⇧T is already
# bound by default to `undo` (reopen the most recently closed tab/split),
# which is generally more useful. Uncomment to mimic iTerm2 instead:
# keybind = super+shift+t=new_tab


# --- Natural Text Editing (ported from iTerm2) ---
# These send the same byte sequences your iTerm2 profile sends.
# Ghostty already binds most of these by default; the two below are the ones
# iTerm2 ships in its preset that Ghostty does NOT bind out of the box.
#
# Already-default in Ghostty (kept commented for reference):
#   keybind = super+arrow_left=text:\x01    # Cmd+←  → start of line (^A)
#   keybind = super+arrow_right=text:\x05   # Cmd+→  → end of line   (^E)
#   keybind = super+backspace=text:\x15     # Cmd+⌫  → kill to line start (^U)
#   keybind = alt+arrow_left=esc:b          # ⌥+←   → word back
#   keybind = alt+arrow_right=esc:f         # ⌥+→   → word fwd

# ⌥+⌫  → delete word backward.
# Use Ctrl+W (0x17) — the universal tty WERASE code that works in bash, zsh,
# Ink/Node apps like Claude Code, vim, etc. (ESC+DEL is the older bash-only
# convention and isn't recognized by Claude Code's input handler.)
keybind = alt+backspace=text:\x17

# ⌥+⌦ (Option + Forward Delete / fn+⌥+⌫) → delete word forward
keybind = alt+delete=esc:d

# ⌦ (forward delete, fn+⌫) → send ^D (matches your iTerm2 "Send Hex Codes: 0x4")
keybind = delete=text:\x04
