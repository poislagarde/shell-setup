# --- Quick Terminal ---

# Global hotkey to summon/dismiss. `global:` makes it work even when Ghostty
# isn't focused, so the toggle works from any app.
# ⌥Space is a familiar default (alternative: `global:cmd+grave_accent`).
keybind = global:alt+space=toggle_quick_terminal

# Where the panel slides in from: top | bottom | left | right | center
quick-terminal-position = top

# Size of the panel — pinned in pixels so column/row count stays constant
# across monitors of different sizes. Format for position=top is
# `HEIGHT,WIDTH`; omitting the second value lets Ghostty maximize the
# secondary axis, which makes the width change between displays.
#
# 778px ≈ 48 rows at JetBrains Mono 12pt (see font-size below, ~16px/row). Nudge
# ±16px to hit a target row count. Width 1466px ≈ 203 columns at the same font
# (~7.2px/cell advance); pinning px keeps the row/column count constant across
# monitors of different sizes.
quick-terminal-size = 778px,1466px

# Which display to show on: main | mouse | macos-menu-bar
quick-terminal-screen = mouse

# Slide animation length in seconds. 0 disables.
quick-terminal-animation-duration = 0.2

# Hide automatically when focus leaves it.
quick-terminal-autohide = false

# Follow the active macOS Space instead of staying pinned: move | remain | move-and-attach
quick-terminal-space-behavior = move

# --- Window restore ---
# Save window state (positions, sizes, tabs, splits, and — via shell
# integration — working directories) on every exit, not just forced
# terminations, and restore it on launch. macOS only. Restored surfaces get
# fresh shells.
window-save-state = always

# No blank window at launch — ⌥Space is the way in. A startup window's shell
# has no GHOSTTY_QUICK_TERMINAL, so it claims a *regular* tmux session and the
# quick session holding your work stays detached behind it. macOS keeps Ghostty
# running with no windows (quit-after-last-window-closed defaults to false), so
# the global hotkey and ⌘N still work, and saved windows still restore.
initial-window = false

# --- Appearance ---
# Slightly translucent background (~5% transparency). Ghostty's scale is the
# inverse: 1.0 = opaque, 0.0 = invisible.
background-opacity = 0.95

# Do NOT set `font-family` here. The tmux pane-border glyphs (branch U+E725,
# folder U+F07C) come from Symbols Nerd Font Mono (installed by /shell-setup via
# `brew install --cask font-symbols-only-nerd-font`), and Ghostty's automatic
# fallback already resolves them at single-cell width — verified, no explicit
# config needed. Adding `font-family = JetBrains Mono` + `font-family = Symbols
# Nerd Font Mono` here inflates the grid cell width and renders ALL text
# spaced-out / double-width (the symbol font's metrics leak into the cell
# metrics). Leaving the font implicit keeps both the text and the glyphs correct.

# Default for JetBrains Mono is 13pt; 12 is a touch smaller (more rows/columns
# in the same window). See the quick-terminal-size note above for how this
# affects the row/column math.
font-size = 12
font-thicken = true
window-colorspace = srgb

# --- Mouse behavior ---
# Deliberately NOT setting mouse-shift-capture: Shift must stay Ghostty's
# mouse-reporting bypass so Cmd+Shift+click opens links while tmux owns the
# mouse. The tmux pane/window drag-swaps use Ctrl instead (C- bindings),
# which the mouse protocol forwards to tmux on its own.

# --- Keyboard behavior ---
# Treat the Option key as Alt so `alt+*` keybinds (and Meta-prefixed shell
# shortcuts) fire. Without this, Option+Backspace, Option+arrows, etc. don't
# trigger keybinds — Ghostty passes them through as macOS dead-key sequences.
# Set to `left` to let Right-Option keep typing characters like ®, ¨.
macos-option-as-alt = true

# Do NOT bind shift+space here. A keybind fires ahead of macOS text input, so
# it discards a pending dead key (US-International `"` + Shift+Space must still
# type `"`). tmux normalizes Shift+Space to a plain space instead — see the
# `bind -n S-Space` line in ~/.tmux.conf.

# Shift+Enter — send the same ESC+Enter byte sequence as Alt+Enter. Codex TUI
# treats that as "insert newline" (it ignores the CSI 27 modified-key
# encoding, so don't switch to that form). zsh binds this sequence back to a
# literal newline too, so shells get the same multi-line editing behavior.
keybind = shift+enter=text:\x1b\x0d

# --- Pane management ---
# Keep the custom Ghostty-native split, focus, and zoom bindings disabled;
# herdr/tmux own these chords.
# keybind = ctrl+shift+==new_split:right
# keybind = ctrl+shift+-=new_split:down
# keybind = performable:super+alt+left=goto_split:left
# keybind = performable:super+alt+right=goto_split:right
# keybind = performable:super+alt+up=goto_split:up
# keybind = performable:super+alt+down=goto_split:down
# keybind = performable:alt+shift+enter=toggle_split_zoom

# Ghostty's defaults already cover the rest of the split workflow:
#   ⌘W       → close_surface            (close current pane)
#   ⌘] / ⌘[  → goto_split:next/previous
#   ⌘D / ⌘⇧D → also bound to new_split:right / new_split:down (bonus paths)

# ⌘⌥+arrow → send modifier-11 arrow sequences; herdr and tmux both bind them to
# spatial pane focus. In a bare shell, ~/.zshrc swallows these sequences.
keybind = super+alt+left=csi:1;11D
keybind = super+alt+right=csi:1;11C
keybind = super+alt+up=csi:1;11A
keybind = super+alt+down=csi:1;11B

# herdr cycles tabs with ⌘⇧[ / ⌘⇧] and splits with ⌘⇧= / ⌘⇧-; tmux reads the
# same chords as M-S-… (Cmd is Meta to it) for pane cycling and splits. Forward
# them as CSI u (key;modifiers, 10 = Cmd+Shift), which both decode; this
# replaces Ghostty's own tab bindings on the bracket chords.
keybind = super+shift+[=csi:91;10u
keybind = super+shift+]=csi:93;10u
keybind = super+shift+==csi:61;10u
keybind = super+shift+-=csi:45;10u

# ⌘⇧T is bound by default to `undo` (reopen the most recently closed tab/
# split). Uncomment to rebind to `new_tab` instead:
# keybind = super+shift+t=new_tab

# --- Natural Text Editing ---
# Ghostty already binds most of these by default; the ones below cover the
# gaps it does NOT bind out of the box.
#
# Already-default in Ghostty (kept commented for reference):
#   keybind = super+arrow_left=text:\x01    # Cmd+←  → start of line (^A)
#   keybind = super+arrow_right=text:\x05   # Cmd+→  → end of line   (^E)
#   keybind = super+backspace=text:\x15     # Cmd+⌫  → kill to line start (^U)
#   keybind = alt+arrow_left=esc:b          # ⌥+←   → word back
#   keybind = alt+arrow_right=esc:f         # ⌥+→   → word fwd

# ⌘+⌫  → delete to line start (^U). Paired with `bindkey '^U' backward-kill-line`
# in ~/.zshrc — zsh's default `^U` is `kill-whole-line` which doesn't match
# macOS semantics.
keybind = super+backspace=text:\x15

# ⌥+⌫  → delete word backward.
# Use Ctrl+W (0x17) — the universal tty WERASE code that works in bash, zsh,
# Ink/Node apps like Claude Code, vim, etc. (ESC+DEL is the older bash-only
# convention and isn't recognized by Claude Code's input handler.)
keybind = alt+backspace=text:\x17

# ⌥+⌦ (Option + Forward Delete / fn+⌥+⌫) → delete word forward
keybind = alt+delete=esc:d

# ⌦ (forward delete, fn+⌫) → send ^D
keybind = delete=text:\x04

# ⌘K → Ctrl+L. Ghostty's default super+k=clear_screen clears Ghostty's
# scrollback, but inside tmux that buffer is empty (tmux owns the screen),
# so it appears to do nothing. Sending Ctrl+L instead lets:
#   - outside tmux: the shell's clear-screen widget fire (zsh redraws prompt)
#   - inside tmux:  our `bind -n C-l send-keys C-l \; clear-history` upgrade
#                   clear both the screen and tmux's scrollback.
keybind = super+k=text:\x0c

# ⌘⇧K → nuke Ghostty's own scrollback buffer (the original super+k behavior).
# Useful outside tmux when you want the full wipe instead of just a viewport
# redraw. Inside tmux it's a no-op (tmux owns the screen) — use ⌘K there.
keybind = super+shift+k=clear_screen
