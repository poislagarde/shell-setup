diff --git a/src/build/repack-static-archives.sh b/src/build/repack-static-archives.sh
new file mode 100755
index 000000000..8b7e462b1
--- /dev/null
+++ b/src/build/repack-static-archives.sh
@@ -0,0 +1,24 @@
+#!/bin/bash
+set -euo pipefail
+
+output=$1
+shift
+scratch=$(mktemp -d)
+trap 'rm -rf "$scratch"' EXIT
+
+objects=()
+index=0
+for archive in "$@"; do
+  archive=$(realpath "$archive")
+  directory="$scratch/$index"
+  mkdir -p "$directory"
+  (cd "$directory" && xcrun ar -x "$archive")
+  for object in "$directory"/*.o; do
+    [[ -e "$object" ]] || continue
+    chmod u+r "$object"
+    objects+=("$object")
+  done
+  index=$((index + 1))
+done
+
+xcrun libtool -static -o "$output" "${objects[@]}"
