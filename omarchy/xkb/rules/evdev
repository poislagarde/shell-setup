// shell-setup's XKB rules, read from ~/.config/xkb before /etc/xkb. They load
// Omarchy's rules (which load the system's), make US International's ` key a
// plain key, and turn Caps Lock into Hyper wherever Omarchy's Caps Lock option
// is set. Omarchy only: without /etc/xkb/rules/evdev no keymap compiles, so
// remove the ~/.config/xkb/rules/evdev link if Omarchy drops it.
! include %E/evdev

! layout variant = symbols
  us intl = +shell-setup(plain_grave)

! option = symbols
  omarchy:shift_caps_compose = +shell-setup(caps_hyper)
