{
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647",
    "CLAUDE_CODE_NATIVE_CURSOR": "1"
  },
  "enabledPlugins": {
    "engineering@knowledge-work-plugins": true,
    "show-your-work@iamumeransari": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "iamumeransari": {
      "source": {
        "source": "git",
        "url": "https://github.com/iamumeransari/claude-show-your-work.git",
        "ref": "releases"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "showTurnDuration": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "promptSuggestionEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.shell-setup/worktree-guard.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.shell-setup/worktree-register.py drain",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.shell-setup/worktree-register.py drain",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
