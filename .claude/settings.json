{
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647"
  },
  "enabledPlugins": {
    "engineering@knowledge-work-plugins": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "showTurnDuration": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-resurrect/session-track.sh claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh start claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-resurrect/session-cleanup.sh claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh busy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh tool-start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh busy"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh busy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh input"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh busy"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh input"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh busy"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh input"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh idle"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.shell-setup/assistant-activity/set-state.sh idle"
          }
        ]
      }
    ]
  }
}
