#!/usr/bin/env bash
set -eu

case "${1:-}" in
--version)
	IFS= read -r version <"$FAKE_CODEX_VERSION_FILE"
	printf '%s\n' "$version"
	;;
resume)
	printf '%s\n' "$*" >>"$FAKE_CODEX_CALLS_FILE"
	case "${FAKE_CODEX_MODE:-normal}" in
	update)
		if [ ! -e "$FAKE_CODEX_UPDATED_FILE" ]; then
			: >"$FAKE_CODEX_UPDATED_FILE"
			printf '%s\n' 'codex-cli 2.0.0' >"$FAKE_CODEX_VERSION_FILE"
			printf '\033[?1049hstartup update prompt\033[?1049l'
			printf '%s\n' 'Update ran successfully! Please restart Codex.'
		fi
		;;
	external-update)
		printf '%s\n' 'codex-cli 2.0.0' >"$FAKE_CODEX_VERSION_FILE"
		printf '\033[?1049h%s\033[?1049l' \
			'Update ran successfully! Please restart Codex.'
		;;
	failed-update)
		printf '%s\n' 'codex-cli 2.0.0' >"$FAKE_CODEX_VERSION_FILE"
		exit 7
		;;
	esac
	;;
*)
	exit 2
	;;
esac
