# Oh My Zsh — extends, doesn't replace.
# Runs AFTER the OMZ-installer-default zshrc (which sets ZSH and sources OMZ
# with plugins=(git)). We override scalar opinions (theme, autotitle, update
# mode), then extend the `plugins` array additively so any plugins enabled
# above this block survive. `typeset -U` de-dups so OMZ doesn't double-load
# anything. The `source` at the bottom re-runs OMZ with the merged set — OMZ
# reads `plugins` only during its `source`, so re-sourcing is what makes the
# additions actually load.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="refined"
zstyle ':omz:update' mode auto
DISABLE_AUTO_TITLE="true"
plugins+=(git nvm autojump golang)
typeset -U plugins

# NVM: use ~/.nvm so brew upgrades don't wipe node installations
export NVM_DIR="$HOME/.nvm"

# Homebrew Shell Completion
FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"

source $ZSH/oh-my-zsh.sh

# Cmd+Backspace in Ghostty sends ^U. zsh's default `^U` is `kill-whole-line`
# (whole line), which doesn't match macOS Cmd+Backspace semantics. Rebind to
# `backward-kill-line` so it only clears from the cursor to the start of line.
bindkey '^U' backward-kill-line

# Shift+Enter → insert a literal newline (keep editing on next line) instead
# of submitting. Ghostty sends it as ESC+Enter to match the Alt+Enter sequence
# Codex TUI understands; the CSI 27 binding covers any terminal/tmux path that
# emits that modified-key form.
zle-insert-newline() { LBUFFER+=$'\n' }
zle -N zle-insert-newline
bindkey '^[^M' zle-insert-newline
bindkey '^[[27;2;13~' zle-insert-newline

# Shift+Space → insert a normal space. `extended-keys always` makes tmux
# re-encode Shift+Space as the CSI 27 form (^[[27;2;32~, 32=space, 2=shift)
# and forward it to zsh, which otherwise can't decode it and leaks the `2~`
# tail. Bind it back to inserting a literal space.
zle-insert-space() { LBUFFER+=' ' }
zle -N zle-insert-space
bindkey '^[[27;2;32~' zle-insert-space

# Cmd+Opt+arrow → pane navigation, handled by Ghostty/tmux. Inside a Ghostty
# split grid these move spatially; at an edge with no neighbor the chord falls
# through to the shell as modifier 11 (^[[1;11{A,B,C,D}). Bind those to a no-op
# so nothing prints. (Inside tmux they never reach zsh — tmux catches them.)
zle-noop() { }
zle -N zle-noop
bindkey '^[[1;11A' zle-noop
bindkey '^[[1;11B' zle-noop
bindkey '^[[1;11C' zle-noop
bindkey '^[[1;11D' zle-noop

# Cursor: blinking thin bar at the prompt. Outside tmux, Ghostty's default
# already gives us this. Inside tmux, tmux owns cursor rendering and defaults
# to a steady block — so re-assert DECSCUSR=5 (blinking bar) on each prompt.
# Pairs with `terminal-features 'xterm*:cstyle'` in tmux.conf so the escape is
# forwarded to Ghostty instead of swallowed.
_zsh_cursor_blinking_bar() { print -n '\e[5 q' }
precmd_functions+=(_zsh_cursor_blinking_bar)

# Editor
export EDITOR="zed --wait"

# User-installed zsh completions (must come BEFORE compinit so it picks them up)
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)

# Fix for Docker & AWS plugin completions
autoload bashcompinit && bashcompinit
autoload -Uz compinit && compinit -i

# PATH
export PATH="$HOME/bin:$PATH"
export PATH="$PATH:$HOME/.local/bin"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# AWS SSO: log in with a profile and export its credentials into the current shell
# Usage: awsenv <profile>     e.g. awsenv dev | awsenv prod | awsenv prod-admin
awsenv() {
  local profile="$1"
  if [[ -z "$profile" ]]; then
    echo "Usage: awsenv <profile>" >&2
    return 1
  fi
  export AWS_PROFILE="$profile"
  aws sso login --profile "$profile" || return $?
  eval "$(aws configure export-credentials --profile "$profile" --format env)"
}

# Claude Code.
# CLAUDE_CODE_TMUX_TRUECOLOR=1 disables Claude Code's hard-coded color-level
# downgrade from 24-bit to 256-palette whenever it sees $TMUX is set (a
# pessimistic fallback for tmux setups that don't pass true color through).
# Our tmux config (default-terminal=tmux-256color + xterm*:Tc override) does
# support 24-bit end-to-end, so we opt back into full color. Harmless outside
# tmux — the var is only consulted when $TMUX is set.
alias claude='CLAUDE_CODE_TMUX_TRUECOLOR=1 claude --chrome'

# Root of the projects tree. Consumed by the tmux C-M-p bind (see tmux.conf),
# which opens a new Claude Code window here. Exported (not just set) so it's
# visible to the `zsh -ic` that bind spawns; change it per-machine as needed.
export PROJECTS_DIR="$HOME/darwin-ai/darwin-platform"

# tm — tmux session helper. `tm <name>` attaches to (or creates) the named
# session, switching the current client instead when already inside tmux.
# Plain `tm` shows a numbered picker of existing sessions, each marked
# (attached)/(detached), via zsh's `select` builtin (no fzf dependency).
# Inside tmux, Alt+Shift+S (choose-tree, see tmux.conf) is the richer equivalent;
# `tm` is mainly for shells outside tmux — the detached escape-hatch shell,
# VS Code's terminal, ssh. Names/labels are split from ONE list-sessions
# call (tab-separated) so the two arrays can't drift if sessions churn.
tm() {
  emulate -L zsh
  if (( $# )); then
    if [[ -n "$TMUX" ]]; then
      tmux new-session -d -s "$1" 2>/dev/null
      tmux switch-client -t "=$1"
    else
      tmux new-session -A -s "$1"
    fi
    return
  fi
  local -a lines names display
  lines=(${(f)"$(tmux list-sessions \
    -F '#{session_name}	#{session_windows}w#{?session_attached, (attached), (detached)}' \
    2>/dev/null)"})
  if (( ${#lines} == 0 )); then
    echo "tm: no tmux sessions — use \`tm <name>\` to start one" >&2
    return 1
  fi
  names=("${(@)lines%%	*}")
  display=("${(@)lines/	/ — }")
  local choice PS3="tm> "
  select choice in "${display[@]}"; do
    [[ -n "$choice" ]] || { echo "tm: invalid choice" >&2; return 1 }
    if [[ -n "$TMUX" ]]; then
      tmux switch-client -t "=${names[$REPLY]}"
    else
      tmux attach-session -t "=${names[$REPLY]}"
    fi
    return
  done
  return 1  # reached on EOF (Ctrl+D) — nothing picked
}

# Ghostty shells live inside tmux. Two attach policies, split on the
# GHOSTTY_QUICK_TERMINAL=1 env var (Ghostty ≥1.3 sets it in quick-terminal
# shells; splits created inside the quick terminal inherit it only on builds
# NEWER than 1.3.1 — the newSplit() override landed on main after the 1.3.1
# release, so on 1.3.1 a Ghostty split in the quick terminal lacks the var
# and joins the regular namespace below; use tmux splits there instead,
# which also survive quits — Ghostty doesn't save quick-terminal layout):
#   - Quick terminal → owns the "quick" namespace: quick, quick-2, quick-3,
#     … Each quick-terminal surface adopts the lowest-numbered detached
#     quick* session (sort -V orders "quick" before "quick-2" before
#     "quick-10"), so the first summon always gets the scratchpad back and
#     a Ghostty split inside the quick terminal gets its own quick-N
#     instead of mirroring the first pane. No detached one → create "quick"
#     if it's missing, else mint the next free quick-N.
#   - Regular windows/tabs/panes → same dance outside the quick namespace:
#     adopt the first detached non-quick* session; otherwise create "main"
#     if it's missing, else a fresh auto-numbered session.
# Surfaces therefore never mirror — each gets its own session. Closing a
# tab/pane only detaches its session, ready for the next surface of the
# same kind to re-adopt; kill sessions you're done with
# (`tmux kill-session -t name`) or resurrect will persist them forever.
# Paired with tmux-resurrect/continuum in tmux.conf, this is what makes
# quitting Ghostty or rebooting the Mac non-destructive — the launchd agent
# (local.shell-setup.tmux-server, §17) boots the tmux server at login, continuum
# restores ALL saved sessions (detached), and each Ghostty surface re-adopts
# one of them. (Without the agent, the first shell boots the server instead —
# the cold-boot branches below.) Guards:
#   -o interactive — defensive; .zshrc shouldn't load otherwise
#   -z $TMUX       — don't nest inside an existing session
#   TERM_PROGRAM   — Ghostty only (leaves VS Code's terminal, ssh, etc. alone)
# Deliberately NOT `exec`: detaching (prefix+d) falls back to this plain zsh
# instead of closing the surface — that's also the escape hatch when you want
# a vanilla non-tmux shell. From there `tmux attach -t name` mirrors a
# session onto a second surface on purpose, which the auto-attach never
# does. The list-sessions -f filters (need tmux ≥3.2) match detached
# (#{session_attached} is the attached-client COUNT, hence ==0) sessions in
# or out of the quick namespace; the m/r flag is an anchored regex match, so
# a session named "quicknotes" counts as regular, not quick. -F prints just
# the name, robust to names with spaces. Session targets use tmux's `=name`
# exact-match prefix and MUST stay quoted: a bare `=word` triggers zsh's
# =-expansion (command-path lookup) and errors out.
if [[ -o interactive && -z "$TMUX" && "$TERM_PROGRAM" == "ghostty" ]]; then
  if [[ -n "$GHOSTTY_QUICK_TERMINAL" ]]; then
    _tmux_detached=$(tmux list-sessions \
      -f '#{&&:#{==:#{session_attached},0},#{m/r:^quick(-[0-9]+)?$,#{session_name}}}' \
      -F '#{session_name}' 2>/dev/null | sort -V | head -n 1)
    if [[ -n "$_tmux_detached" ]]; then
      tmux attach-session -t "=$_tmux_detached"
    elif ! tmux has-session -t '=quick' 2>/dev/null; then
      # Also the cold-boot path: this boots the server, continuum restores
      # all saved sessions, and -A attaches the restored "quick".
      tmux new-session -A -s quick
    else
      _tmux_n=2
      while tmux has-session -t "=quick-$_tmux_n" 2>/dev/null; do
        (( _tmux_n++ ))
      done
      tmux new-session -s "quick-$_tmux_n"
    fi
    unset _tmux_detached _tmux_n
  else
    _tmux_detached=$(tmux list-sessions \
      -f '#{&&:#{==:#{session_attached},0},#{?#{m/r:^quick(-[0-9]+)?$,#{session_name}},0,1}}' \
      -F '#{session_name}' 2>/dev/null | head -n 1)
    if [[ -n "$_tmux_detached" ]]; then
      tmux attach-session -t "=$_tmux_detached"
    elif ! tmux has-session -t '=main' 2>/dev/null; then
      # Also the cold-boot path: this boots the server, continuum restores
      # all saved sessions, and -A attaches the restored "main".
      tmux new-session -A -s main
    else
      tmux new-session
    fi
    unset _tmux_detached
  fi
fi
