# Oh My Zsh — extends, doesn't replace.
# Runs AFTER the OMZ-installer-default zshrc (which sets ZSH and sources OMZ
# with plugins=(git)). We override scalar opinions (theme, autotitle, update
# mode), then extend the `plugins` array additively so any plugins enabled
# above this block survive. `typeset -U` de-dups so OMZ doesn't double-load
# anything. The `source` at the bottom re-runs OMZ with the merged set — OMZ
# reads `plugins` only during its `source`, so re-sourcing is what makes the
# additions actually load.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="refined"
zstyle ':omz:update' mode auto
DISABLE_AUTO_TITLE="true"
plugins+=(git nvm autojump golang)
typeset -U plugins

# NVM: use ~/.nvm so brew upgrades don't wipe node installations
export NVM_DIR="$HOME/.nvm"

# mise-managed tools, where mise is installed (Omarchy ships claude, codex and
# gh through it). Activate before Oh My Zsh so nvm's node stays ahead on PATH.
command -v mise >/dev/null && eval "$(mise activate zsh)"

# Homebrew Shell Completion
command -v brew >/dev/null && FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"

source $ZSH/oh-my-zsh.sh

# Cmd+Backspace in Ghostty sends ^U. zsh's default `^U` is `kill-whole-line`
# (whole line), which doesn't match macOS Cmd+Backspace semantics. Rebind to
# `backward-kill-line` so it only clears from the cursor to the start of line.
bindkey '^U' backward-kill-line

# Shift+Enter → insert a literal newline (keep editing on next line) instead
# of submitting. Ghostty sends it as CSI 13;2u; Alt+Enter (ESC+Enter) does the
# same in a bare shell. Inside herdr, zsh gets Shift+Enter as a plain Enter.
zle-insert-newline() { LBUFFER+=$'\n' }
zle -N zle-insert-newline
bindkey '^[[13;2u' zle-insert-newline
bindkey '^[^M' zle-insert-newline

# herdr's pane chords in a bare shell: bind them to a no-op so nothing prints.
# Ctrl+Alt(+Shift)+arrow arrive with modifiers 7 and 8, and Alt+Shift+Enter as
# CSI 13;4u (Omarchy's Ghostty config). Inside herdr, herdr catches them first.
zle-noop() { }
zle -N zle-noop
for _key in A B C D; do
  bindkey "^[[1;7$_key" zle-noop
  bindkey "^[[1;8$_key" zle-noop
done
unset _key
bindkey '^[[13;4u' zle-noop
# Ghostty's Alt+Shift+6 (herdr's jump to space 6) arrives as CSI 54;7u.
bindkey '^[[54;7u' zle-noop

# Reassert a blinking thin bar at each prompt, Ghostty's default, in case a
# program changed the cursor shape.
_zsh_cursor_blinking_bar() { print -n '\e[5 q' }
precmd_functions+=(_zsh_cursor_blinking_bar)

# Editor
export EDITOR="zed --wait"

# herdr opens OSC 8 links on Ctrl+click (with mouse capture on, it doesn't hand
# them to Ghostty, so Cmd+Shift+click can't open them). CLIs that sniff
# TERM_PROGRAM (Claude Code's PR link, etc.) don't recognize `herdr` and print
# plain text instead.
[[ $TERM_PROGRAM == herdr ]] && export FORCE_HYPERLINK=1
# Same for kitty graphics: Claude Code only draws images when XTVERSION names
# kitty or Ghostty, so force them on; herdr relays them to Ghostty.
[[ $TERM_PROGRAM == herdr ]] && export CLAUDE_CODE_FORCE_TERMINAL_IMAGES=1

# User-installed zsh completions (must come BEFORE compinit so it picks them up)
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)

# Fix for Docker & AWS plugin completions
autoload bashcompinit && bashcompinit
autoload -Uz compinit && compinit -i

# PATH
export PATH="$HOME/bin:$PATH"
export PATH="$PATH:$HOME/.local/bin"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# AWS SSO: log in with a profile and export its credentials into the current shell
# Usage: awsenv <profile>     e.g. awsenv dev | awsenv prod | awsenv prod-admin
awsenv() {
  local profile="$1"
  if [[ -z "$profile" ]]; then
    echo "Usage: awsenv <profile>" >&2
    return 1
  fi
  export AWS_PROFILE="$profile"
  aws sso login --profile "$profile" || return $?
  eval "$(aws configure export-credentials --profile "$profile" --format env)"
}

# Claude Code.
alias claude='claude --chrome'

# Codex. Force the preferred reasoning effort on every launch — Codex itself
# rewrites model_reasoning_effort in ~/.codex/config.toml (the /model picker
# and updates persist their own value), so the file can't be trusted to hold.
# An explicit -c beats the file; flags passed on the command line come after
# this one and still win.
alias codex='codex -c model_reasoning_effort=max'

# Machine-local shell settings stay outside this public repository.
if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell-setup/local-env.sh" ]]; then
  source "${XDG_CONFIG_HOME:-$HOME/.config}/shell-setup/local-env.sh"
fi
# Project launchers use the local PROJECTS_DIR setting, falling back to home.
export PROJECTS_DIR="${PROJECTS_DIR:-$HOME}"
